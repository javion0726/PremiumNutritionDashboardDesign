# Copy this file to .env for local development (vite dev picks it up automatically).
# In production (Netlify), set these as real environment variables instead:
#   Site configuration → Environment variables → add both keys below.
#
# If these are left unset, the app runs in local-only mode exactly as it did
# before any of this existed — no login required, nothing breaks. Auth and
# cloud sync only activate once both are set.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
